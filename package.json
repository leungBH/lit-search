{
  "name": "lit-search",
  "version": "1.3.0",
  "description": "Academic literature search CLI and MCP server for Semantic Scholar, OpenAlex, arXiv, CrossRef, and CORE. Outputs reproducible metadata JSON, literature pool JSON, and BibTeX.",
  "keywords": [
    "literature",
    "search",
    "academic",
    "papers",
    "research",
    "semantic-scholar",
    "openalex",
    "arxiv",
    "crossref",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "lit-search": "bin/lit-search.js",
    "lit-search-mcp": "bin/lit-search-mcp.js"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node bin/lit-search.js --help",
    "test:acceptance": "node test.js",
    "test:smoke": "node test.js",
    "diagnose": "node diagnose.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "inquirer": "^9.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
